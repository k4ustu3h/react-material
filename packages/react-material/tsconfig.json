{
  "compilerOptions": {
    "jsx": "react",
    "module": "esnext",
    "target": "esnext",
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ]
  },
  "include": [
    "index.ts",
    "types.d.ts",
    "components",
    "utils"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "types",
    "utils/material-color-utilities/**/*_test.ts",
  ]
}