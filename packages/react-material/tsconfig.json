{
  "compilerOptions": {
    "jsx": "react",
    "module": "esnext",
    "target": "esnext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "sourceMap": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "include": [
    "index.ts",
    "types.d.ts",
    "components",
    "utils"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "esbuild.config.js",
    "build.js",
    "**/test.ts",
    "**/test.tsx",
    "**/*_test.ts",
    "**/*_test.tsx"
  ]
}