{
  "name": "react-material",
  "version": "0.0.1-alpha3",
  "author": "miukyo",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20250704.1",
    "chokidar": "^4.0.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.5",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-d.ts": "^1.3.1",
    "glob": "^11.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./*.css": {
      "import": "./dist/css/*.css",
      "require": "./dist/css/*.css"
    }
  },
  "description": "Material Design 3 Expressive Implementation in React",
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "material design",
    "ui components",
    "frontend",
    "web development",
    "design system",
    "expressive",
    "responsive",
    "accessible",
    "modern web",
    "react components",
    "material ui",
    "material design 3",
    "md3",
    "react material"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "rimraf dist && node build.js build",
    "dev": "node build.js dev",
    "tsgo": "tsgo",
    "generate": "turbo gen react-component && bun run build"
  },
  "types": "dist/types/index.d.ts",
  "dependencies": {
    "react-material-color-utils": "^0.3.1-nightly.2"
  }
}
