{
  "name": "react-material",
  "author": "miukyo",
  "version": "0.0.1-pre1",
  "description": "Material Design 3 Expressive Implementation in React",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "material design",
    "ui components",
    "frontend",
    "web development",
    "design system",
    "expressive",
    "responsive",
    "accessible",
    "modern web",
    "react components",
    "material ui",
    "material design 3",
    "md3",
    "react material"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  },
  "files": ["dist"],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "glob": "^11.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^5.4.2",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-lib-inject-css": "^2.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "generate": "turbo gen react-component && bun run build"
  },
  "dependencies": {
    "postcss": "^8.5.4"
  }
}
