{
  "name": "react-material",
  "author": "miukyo",
  "version": "0.0.1-pre1",
  "description": "Material Design 3 Expressive Implementation in React",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "material design",
    "ui components",
    "frontend",
    "web development",
    "design system",
    "expressive",
    "responsive",
    "accessible",
    "modern web",
    "react components",
    "material ui",
    "material design 3",
    "md3",
    "react material"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/bun": "latest",
    "@web/rollup-plugin-copy": "^0.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rolldown": "^1.0.0-beta.11",
    "rolldown-plugin-dts": "^0.13.8",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "rollup -c ./rollup.config.js --bundleConfigAsCjs",
    "dev": "rollup -c ./rollup.config.js --bundleConfigAsCjs --watch",
    "generate": "turbo gen react-component && npm run build"
  },
  "types": "dist/index.d.ts",
  "dependencies": {
    "material-symbols": "^0.31.5",
    "postcss": "^8.5.4",
    "rollup-plugin-postcss": "^4.0.2"
  }
}
